# ─── Main ─────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="self-improvement",
        description="Track autonomous loop session metrics and improvement efforts."
    )
    sub = parser.add_subparsers(dest="command")

    # log
    p_log = sub.add_parser("log", help="Parse a JSONL iteration file and log session metrics")
    p_log.add_argument("file", help="Path to claude-iteration-N.jsonl file")

    # backfill
    p_bf = sub.add_parser("backfill", help="Bulk-parse iteration files into the database")
    p_bf.add_argument("--from", dest="from_id", type=int, help="Start iteration ID")
    p_bf.add_argument("--to", dest="to_id", type=int, help="End iteration ID")

    # status
    p_st = sub.add_parser("status", help="Show dashboard with recent sessions and trends")
    p_st.add_argument("--last", type=int, default=10, help="Number of recent sessions to show")

    # analyze
    p_an = sub.add_parser("analyze", help="Deep analysis of recent sessions")
    p_an.add_argument("--last", type=int, default=10, help="Number of sessions to analyze")

    # targets
    sub.add_parser("targets", help="Show efficiency targets and recent performance")

    # improvement subcommands
    p_imp = sub.add_parser("improvement", help="Manage improvement records")
    imp_sub = p_imp.add_subparsers(dest="imp_command")

    p_add = imp_sub.add_parser("add", help="Add a new improvement")
    p_add.add_argument("--title", required=True, help="Short title")
    p_add.add_argument("--severity", required=True, choices=["high", "medium", "low"])
    p_add.add_argument("--desc", help="Detailed description")
    p_add.add_argument("--rec", help="Recommendation")
    p_add.add_argument("--tags", help="Comma-separated tags")

    p_fix = imp_sub.add_parser("fix", help="Mark an improvement as fixed")
    p_fix.add_argument("id", help="Improvement ref_id (e.g., R5) or numeric id")
    p_fix.add_argument("--impact", help="Measured impact description")

    p_list = imp_sub.add_parser("list", help="List improvements")
    p_list.add_argument("--status", choices=["open", "fixed", "wontfix", "monitoring"])
    p_list.add_argument("--verbose", "-v", action="store_true")

    p_search = imp_sub.add_parser("search", help="Search improvements by keyword")
    p_search.add_argument("query", help="Search term")

    # seed
    sub.add_parser("seed", help="Seed improvements table with historical R1-R14 records")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return 1

    if args.command == "log":
        return cmd_log(args)
    elif args.command == "backfill":
        return cmd_backfill(args)
    elif args.command == "status":
        return cmd_status(args)
    elif args.command == "analyze":
        return cmd_analyze(args)
    elif args.command == "targets":
        return cmd_targets(args)
    elif args.command == "seed":
        return cmd_seed(args)
    elif args.command == "improvement":
        if not args.imp_command:
            p_imp.print_help()
            return 1
        if args.imp_command == "add":
            return cmd_improvement_add(args)
        elif args.imp_command == "fix":
            return cmd_improvement_fix(args)
        elif args.imp_command == "list":
            return cmd_improvement_list(args)
        elif args.imp_command == "search":
            return cmd_improvement_search(args)
    return 1


if __name__ == "__main__":
    sys.exit(main() or 0)
